{# Mise en page commune des emails. Les styles sont « inline » : c'est la seule façon fiable dans les clients mail. #}
<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#f6f1e8;font-family:Helvetica,Arial,sans-serif;color:#23211d;">
    <div style="max-width:520px;margin:0 auto;background:#fffdf9;border:1px solid #e2d9c8;border-radius:12px;padding:32px;">
        <p style="margin:0 0 24px;font-family:Georgia,serif;font-size:22px;font-weight:bold;">Book<em style="color:#a8603f;">Share</em></p>
        {% block content %}{% endblock %}
        <p style="margin:32px 0 0;font-size:12px;color:#6b6458;">Tu reçois cet email car un compte BookShare utilise cette adresse. Si ce n'est pas toi, ignore-le simplement.</p>
    </div>
</body>
</html>
