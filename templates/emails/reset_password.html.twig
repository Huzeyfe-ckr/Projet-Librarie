{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <p>Bonjour {{ user.username }},</p>
    <p>Tu as demandé à changer ton mot de passe. Clique sur le bouton pour en choisir un nouveau :</p>
    <p style="margin:28px 0;">
        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="background:#3d5a4a;color:#f6f1e8;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:bold;">Choisir un nouveau mot de passe</a>
    </p>
    <p style="font-size:13px;color:#6b6458;">Ce lien expire dans 1 heure. Si tu n'as rien demandé, ton mot de passe actuel reste valable.</p>
{% endblock %}
