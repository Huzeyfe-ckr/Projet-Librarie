<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}BookShare{% endblock %}</title>
    <style>
        :root {
            --bg: #faf8f5;
            --card: #ffffff;
            --text: #2b2b2b;
            --muted: #6b6b6b;
            --primary: #2f6f5e;
            --primary-dark: #245748;
            --border: #e6e1d9;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }
        a { color: var(--primary); text-decoration: none; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

        .navbar { background: var(--card); border-bottom: 1px solid var(--border); }
        .navbar .container { display: flex; align-items: center; justify-content: space-between; height: 64px; }
        .brand { font-weight: 700; font-size: 1.25rem; color: var(--primary); }
        .nav-links { display: flex; align-items: center; gap: 18px; }
        .nav-links a { color: var(--text); }
        .nav-links a:hover { color: var(--primary); }

        .btn { display: inline-block; padding: 10px 20px; border-radius: 8px; font-weight: 600; border: 2px solid var(--primary); cursor: pointer; }
        .btn-primary { background: var(--primary); color: #fff !important; }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-outline { background: transparent; color: var(--primary) !important; }
        .btn-outline:hover { background: var(--primary); color: #fff !important; }

        .flash { padding: 12px 16px; border-radius: 8px; margin: 16px 0; background: #e6f4ee; color: #1d5a45; }
        .flash-error { background: #fbe9e9; color: #8a2b2b; }

        .section-title { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; flex-wrap: wrap; gap: 8px; }
        .section-title h1, .section-title h2 { margin: 0; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
        .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
        .card h3 { margin: 10px 0 6px; }
        .card p { margin: 6px 0; }
        .empty { text-align: center; color: var(--muted); padding: 40px; background: var(--card); border: 1px dashed var(--border); border-radius: 12px; }
        .meta { color: var(--muted); font-size: .9rem; }
        .card-badges { display: flex; gap: 8px; flex-wrap: wrap; }
        .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: .8rem; background: #eef3f1; color: var(--primary); font-weight: 600; }
        .badge-price { background: #fdf1dc; color: #8a5a00; }
        .search-form { display: flex; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; }
        .search-form input { flex: 1; min-width: 220px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 1rem; }
        .pagination { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 30px; }
        .detail { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 30px; margin-top: 12px; }
        .detail h1 { margin: 12px 0 4px; }
        .book-box { border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px; margin-bottom: 12px; }
        .book-box ul { margin: 8px 0 0; padding-left: 18px; color: var(--muted); }

        footer { margin-top: 60px; padding: 24px 0; border-top: 1px solid var(--border); color: var(--muted); text-align: center; font-size: .9rem; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header class="navbar">
        <div class="container">
            <a href="{{ path('app_home') }}" class="brand">📚 BookShare</a>

            <nav class="nav-links">
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('announcement_index') }}">Annonces</a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="/admin">Administration</a>
                {% endif %}

                {% if app.user %}
                    <a href="{{ path('book_new') }}" class="btn btn-primary">Publier un livre</a>
                    <span>Bonjour, <strong>{{ app.user.username }}</strong></span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Inscription</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ label == 'error' or label == 'danger' ? 'flash-error' : '' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer>
        <div class="container">© {{ 'now'|date('Y') }} BookShare — donne et trouve des livres</div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>