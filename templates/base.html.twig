<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="BookShare — donne, vends et trouve des livres d'occasion près de chez toi.">
    <meta name="theme-color" content="#f6f1e8">
    <title>{% block title %}BookShare{% endblock %} · BookShare</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='6' y='6' width='6' height='22' rx='1' fill='%233d5a4a'/><rect x='13' y='3' width='6' height='25' rx='1' fill='%23a8603f'/><rect x='21' y='9' width='6' height='19' rx='1' fill='%23b8913f' transform='rotate(10 24 28)'/></svg>">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% set route = app.request.attributes.get('_route') ?? '' %}

    <header class="site-header" data-header>
        <div class="container site-header__inner">
            <a href="{{ path('app_home') }}" class="brand" aria-label="BookShare, accueil">
                <span class="brand__mark" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>Book<em>Share</em></span>
            </a>

            <button type="button" class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="main-nav">
                <span></span><span></span><span></span>
                <span class="sr-only">Menu</span>
            </button>

            <nav class="nav" id="main-nav">
                <a href="{{ path('app_home') }}" class="nav__link {{ route == 'app_home' ? 'is-active' }}">Accueil</a>
                <a href="{{ path('announcement_index') }}" class="nav__link {{ route starts with 'announcement_' ? 'is-active' }}">Annonces</a>

                {% if app.user %}
                    <a href="{{ path('exchange_index') }}" class="nav__link {{ route starts with 'exchange_' ? 'is-active' }}">Mes échanges</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin') }}" class="nav__link">Admin</a>
                    {% endif %}
                    <span class="nav__sep"></span>
                    {% import '_partials/ui.html.twig' as ui %}
                    <span class="nav__user">{{ ui.avatar(app.user) }}{{ app.user.username }}</span>
                    <a href="{{ path('book_new') }}" class="btn btn-primary">+ Publier</a>
                    <form method="post" action="{{ path('app_logout') }}" class="nav__logout">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-ghost">Déconnexion</button>
                    </form>
                {% else %}
                    <span class="nav__sep"></span>
                    <a href="{{ path('app_login') }}" class="nav__link">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Rejoindre</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main>
        {% set flashes = app.flashes %}
        {% if flashes is not empty %}
            <div class="container flashes" role="status">
                {% for label, messages in flashes %}
                    {% for message in messages %}
                        <div class="flash {{ label in ['error', 'danger'] ? 'flash--error' : (label == 'warning' ? 'flash--warning') }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <a href="{{ path('app_home') }}" class="brand">
                <span class="brand__mark" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>Book<em>Share</em></span>
            </a>
            <p>© {{ 'now'|date('Y') }} BookShare — les livres méritent plusieurs lecteurs.</p>
            <nav>
                <a href="{{ path('announcement_index') }}">Annonces</a>
                {% if app.user %}
                    <a href="{{ path('book_new') }}">Publier</a>
                {% else %}
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </nav>
        </div>
    </footer>

    <script>
    (function () {
        // Menu mobile
        var header = document.querySelector('[data-header]');
        var toggle = document.querySelector('[data-nav-toggle]');
        if (toggle) {
            toggle.addEventListener('click', function () {
                var open = header.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        }

        // Apparition douce au scroll
        var items = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
            items.forEach(function (el) { el.classList.add('is-visible'); });
            return;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    io.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        items.forEach(function (el) { io.observe(el); });
    })();
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
