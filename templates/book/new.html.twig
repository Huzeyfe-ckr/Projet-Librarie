{% extends 'base.html.twig' %}

{% block title %}Publier un livre ou un pack{% endblock %}

{% block body %}
    {% set prototype_html %}
        {% include 'book/_book_entry.html.twig' with {f: form.books.vars.prototype} only %}
    {% endset %}

    <div class="container">
        <div class="form-card">
            <header class="page-head" style="padding-top:8px">
                <p class="eyebrow">Nouvelle annonce</p>
                <h1>Publier un livre ou un pack</h1>
                <p class="muted">Un seul livre, ou plusieurs regroupés sous une même annonce : idéal pour vider une étagère d'un coup.</p>
            </header>

            {{ form_start(form, {attr: {class: 'form'}}) }}
                {{ form_errors(form) }}

                <section class="form-section">
                    <h2 class="form-section__title"><b>1</b> L'annonce</h2>
                    <p>Comment veux-tu proposer tes livres ?</p>

                    {{ form_row(form.title, {attr: {placeholder: 'Ex. : Lot de romans policiers'}}) }}
                    <div class="form-row-2">
                        {{ form_row(form.type) }}
                        <div>
                            {{ form_label(form.price) }}
                            <div class="money">{{ form_widget(form.price, {attr: {placeholder: '0,00'}}) }}</div>
                            {{ form_help(form.price) }}
                            {{ form_errors(form.price) }}
                        </div>
                    </div>
                    {{ form_row(form.description, {attr: {placeholder: 'État général, lieu de remise, disponibilités…'}}) }}
                </section>

                <section class="form-section">
                    <h2 class="form-section__title"><b>2</b> Les livres</h2>
                    <p>Ajoute autant de livres que tu veux (jusqu'à {{ maxBooks }}).</p>
                    {{ form_errors(form.books) }}

                    <div id="book-list"
                         data-prototype="{{ prototype_html|e('html_attr') }}"
                         data-max="{{ maxBooks }}">
                        {% for entry in form.books %}
                            {% include 'book/_book_entry.html.twig' with {f: entry} only %}
                        {% endfor %}
                    </div>
                    {% do form.books.setRendered %}

                    <button type="button" id="add-book" class="add-book">+ Ajouter un livre au pack</button>
                </section>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg">Publier l'annonce</button>
                    <a href="{{ path('announcement_index') }}" class="btn btn-ghost">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    const list = document.getElementById('book-list');
    const addBtn = document.getElementById('add-book');
    const max = parseInt(list.dataset.max, 10);
    // Les index déjà rendus par le serveur sont < 1000 : pas de collision possible
    let nextIndex = 1000;

    function refresh() {
        const entries = list.querySelectorAll('[data-book-entry]');
        entries.forEach(function (entry, i) {
            entry.querySelector('[data-entry-label]').textContent = 'Livre ' + (i + 1);
            entry.querySelector('[data-remove-entry]').hidden = entries.length === 1;
        });
        addBtn.disabled = entries.length >= max;
        addBtn.textContent = entries.length >= 1 ? '+ Ajouter un livre au pack' : '+ Ajouter un livre';
    }

    addBtn.addEventListener('click', function () {
        const html = list.dataset.prototype.replace(/__name__/g, nextIndex++);
        const holder = document.createElement('div');
        holder.innerHTML = html.trim();
        const entry = holder.firstElementChild;
        list.appendChild(entry);
        refresh();
        const firstInput = entry.querySelector('input');
        if (firstInput) firstInput.focus();
    });

    list.addEventListener('click', function (event) {
        const button = event.target.closest('[data-remove-entry]');
        if (!button) return;
        button.closest('[data-book-entry]').remove();
        refresh();
    });

    // Le prix n'a pas de sens pour un don : on désactive le champ
    const type = document.getElementById('{{ form.type.vars.id }}');
    const price = document.getElementById('{{ form.price.vars.id }}');
    function syncPrice() {
        const isDonation = type.value === 'donation';
        price.disabled = isDonation;
        if (isDonation) price.value = '';
        price.closest('.money').style.opacity = isDonation ? '.5' : '1';
    }
    if (type && price) {
        type.addEventListener('change', syncPrice);
        syncPrice();
    }

    refresh();
})();
</script>
{% endblock %}
