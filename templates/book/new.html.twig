{% extends 'base.html.twig' %}

{# Template partagé : création (book_new) et modification (announcement_edit, la variable announcement est alors définie) #}
{% set editing = announcement is defined %}

{% block title %}{{ editing ? 'Modifier l’annonce' : 'Publier un livre ou un pack' }}{% endblock %}

{% block body %}
    {# HTML d'un livre vide, utilisé par le contrôleur Stimulus « book-form » pour ajouter un livre.
       Passé à form_start avec « ~ '' » : on obtient une chaîne simple, que le thème de formulaire échappe une seule fois. #}
    {% set prototype_html %}
        {% include 'book/_book_entry.html.twig' with {f: form.books.vars.prototype} only %}
    {% endset %}

    <div class="container">
        <div class="form-card">
            <header class="page-head page-head--tight">
                {% if editing %}
                    <p class="eyebrow">Modifier l’annonce</p>
                    <h1>{{ announcement.title }}</h1>
                    <p class="muted">Un livre retiré de la liste n’apparaîtra plus sur l’annonce.</p>
                {% else %}
                    <p class="eyebrow">Nouvelle annonce</p>
                    <h1>Publier un livre ou un pack</h1>
                    <p class="muted">Un seul livre, ou plusieurs regroupés sous une même annonce : idéal pour vider une étagère d'un coup.</p>
                {% endif %}
            </header>

            {{ form_start(form, {attr: {class: 'form', 'data-controller': 'book-form', 'data-book-form-prototype-value': prototype_html ~ '', 'data-book-form-max-value': maxBooks}}) }}
                {{ form_errors(form) }}

                <section class="form-section">
                    <h2 class="form-section__title"><b>1</b> L'annonce</h2>
                    <p>Comment veux-tu proposer tes livres ?</p>

                    {{ form_row(form.title, {attr: {placeholder: 'Ex. : Lot de romans policiers'}}) }}
                    <div class="form-row-2">
                        {{ form_row(form.type, {attr: {'data-book-form-target': 'type', 'data-action': 'book-form#syncPrice'}}) }}
                        <div>
                            {{ form_label(form.price) }}
                            <div class="money">{{ form_widget(form.price, {attr: {placeholder: '0,00', 'data-book-form-target': 'price'}}) }}</div>
                            {{ form_help(form.price) }}
                            {{ form_errors(form.price) }}
                        </div>
                    </div>
                    {{ form_row(form.description, {attr: {placeholder: 'État général, lieu de remise, disponibilités…'}}) }}
                </section>

                <section class="form-section">
                    <h2 class="form-section__title"><b>2</b> Les livres</h2>
                    <p>Ajoute autant de livres que tu veux (jusqu'à {{ maxBooks }}).</p>
                    {{ form_errors(form.books) }}

                    <div data-book-form-target="list">
                        {% for entry in form.books %}
                            {# En modification, on passe le livre existant pour afficher ses photos #}
                            {% include 'book/_book_entry.html.twig' with {f: entry, book: (existingBooks ?? [])[loop.index0] ?? null} only %}
                        {% endfor %}
                    </div>
                    {% do form.books.setRendered %}

                    <button type="button" class="add-book" data-book-form-target="addButton" data-action="book-form#add">+ Ajouter un livre au pack</button>
                </section>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-lg">{{ editing ? 'Enregistrer les modifications' : 'Publier l’annonce' }}</button>
                    <a href="{{ editing ? path('announcement_show', {id: announcement.id}) : path('announcement_index') }}" class="btn btn-ghost">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
