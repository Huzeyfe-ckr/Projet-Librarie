{% import '_partials/ui.html.twig' as ui %}
{% set isPack = books|length > 1 %}
{% set first = books|first %}

<article class="book-card reveal" style="--d: {{ delay ?? 0 }}ms">
    <div class="book-card__visual">
        {{ ui.cover_for(announcement, books) }}

        {% if announcement.price is null %}
            <span class="book-card__price book-card__price--free">Gratuit</span>
        {% else %}
            <span class="book-card__price">{{ announcement.price|number_format(2, ',', ' ') }}&nbsp;€</span>
        {% endif %}
    </div>

    <div class="book-card__body">
        <div class="badges">
            {{ ui.type_badge(announcement.type) }}
            {% if isPack %}<span class="badge badge--plum">Pack · {{ books|length }} livres</span>{% endif %}
            {% if announcement.status.value != 'available' %}{{ ui.announcement_status(announcement.status) }}{% endif %}
        </div>

        <h3 class="book-card__title">
            <a href="{{ path('announcement_show', {id: announcement.id}) }}">{{ announcement.title }}</a>
        </h3>

        {% if isPack %}
            <ul class="book-card__pack">
                {% for book in books|slice(0, 3) %}
                    <li>{{ book.title }}{% if book.author %} — {{ book.author }}{% endif %}</li>
                {% endfor %}
                {% if books|length > 3 %}
                    <li class="muted">et {{ books|length - 3 }} autre{{ books|length - 3 > 1 ? 's' }}…</li>
                {% endif %}
            </ul>
        {% elseif first %}
            <p class="book-card__meta">
                {% if first.author %}{{ first.author }} · {% endif %}{{ first.bookCondition.label }}
            </p>
        {% endif %}

        {% if announcement.description %}
            <p class="book-card__excerpt">{{ announcement.description }}</p>
        {% endif %}

        <div class="book-card__foot">
            {{ ui.avatar(announcement.user) }}
            <span>{{ announcement.user.username }}</span>
            <span style="margin-left:auto">{{ announcement.createdAt|date('d/m/Y') }}</span>
        </div>
    </div>
</article>
