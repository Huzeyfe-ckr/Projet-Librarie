{% extends 'base.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% block title %}Échange : {{ announcement.title }}{% endblock %}

{% block body %}
    <div class="container">
        <nav class="breadcrumb"><a href="{{ path('exchange_index') }}">← Mes échanges</a></nav>

        <div class="chat-layout">
            <section class="chat-card" data-controller="chat">
                <header class="chat-card__head">
                    {{ ui.avatar(other, 'lg') }}
                    <div>
                        <strong>{{ ui.user_link(other) }}</strong>
                        <span>À propos de « {{ announcement.title }} »</span>
                    </div>
                    <div class="ml-auto">{{ ui.exchange_status(exchange.status) }}</div>
                </header>

                <div class="chat" data-chat-target="messages">
                    {% set lastDay = null %}
                    {% for message in messages %}
                        {% set day = message.sentAt|date('d/m/Y') %}
                        {% if day != lastDay %}
                            <span class="chat__day">{{ day == 'now'|date('d/m/Y') ? 'Aujourd’hui' : day }}</span>
                            {% set lastDay = day %}
                        {% endif %}

                        {% set mine = message.sender and message.sender.id == app.user.id %}
                        <div class="bubble {{ mine ? 'bubble--mine' : 'bubble--theirs' }}">
                            {% if not message.sender %}<strong class="small">Utilisateur supprimé</strong><br>{% endif %}
                            {{ message.content|nl2br }}
                            <span class="bubble__time">{{ message.sentAt|date('H:i') }}</span>
                        </div>
                    {% else %}
                        <p class="muted chat__empty">Aucun message pour l'instant.</p>
                    {% endfor %}
                    <div id="bottom"></div>
                </div>

                {% if exchange.status.isOpen() %}
                    {{ form_start(form, {attr: {class: 'chat-form form'}}) }}
                        <div class="chat-form__field">
                            {{ form_errors(form.content) }}
                            {{ form_widget(form.content, {attr: {rows: 1, 'data-chat-target': 'field', 'data-action': 'input->chat#grow keydown->chat#submitOnEnter'}}) }}
                        </div>
                        <button type="submit" class="btn btn-primary" aria-label="Envoyer">
                            Envoyer
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        </button>
                    {{ form_end(form) }}
                {% else %}
                    <p class="chat-closed muted small">Cet échange est clos ({{ ui.exchange_status(exchange.status) }}), tu ne peux plus y répondre.</p>
                {% endif %}
            </section>

            <aside class="panel">
                <p class="eyebrow mb-3">L'annonce</p>
                <div class="cover-thumb mb-4">{{ ui.cover_for(announcement, books) }}</div>
                <h3>{{ announcement.title }}</h3>
                <div class="badges mb-4">
                    {{ ui.type_badge(announcement.type) }}
                    {{ ui.announcement_status(announcement.status) }}
                </div>
                {{ ui.price(announcement) }}
                <p class="small muted mt-3">Demande ouverte le {{ exchange.initiatedAt|date('d/m/Y') }}</p>

                {# ===== Actions sur l'échange (droits vérifiés par ExchangeVoter) ===== #}
                {% set actions = [
                    {name: 'accept', right: 'EXCHANGE_ACCEPT', label: 'Accepter la demande', class: 'btn-primary'},
                    {name: 'complete', right: 'EXCHANGE_COMPLETE', label: 'Livre remis : terminer', class: 'btn-primary', confirm: 'Confirmer que le livre a bien été remis ?'},
                    {name: 'refuse', right: 'EXCHANGE_REFUSE', label: 'Refuser', class: 'btn-outline', confirm: 'Refuser cette demande ?'},
                    {name: 'cancel', right: 'EXCHANGE_CANCEL', label: isOwner ? 'Annuler l’échange' : 'Annuler ma demande', class: 'btn-ghost', confirm: 'Annuler cet échange ?'},
                ] %}
                {% set allowed = actions|filter(a => is_granted(a.right, exchange)) %}

                {% if allowed is not empty %}
                    <div class="exchange-actions">
                        {% for action in allowed %}
                            <form method="post" action="{{ path('exchange_transition', {id: exchange.id, action: action.name}) }}" {% if action.confirm is defined %}{{ ui.confirm(action.confirm, action.label) }}{% endif %}>
                                <input type="hidden" name="_token" value="{{ csrf_token('exchange_' ~ action.name ~ '_' ~ exchange.id) }}">
                                <button type="submit" class="btn {{ action.class }} btn-block">{{ action.label }}</button>
                            </form>
                        {% endfor %}
                        {% if is_granted('EXCHANGE_ACCEPT', exchange) %}
                            <p class="small muted">Accepter réserve l’annonce et refuse automatiquement les autres demandes en attente.</p>
                        {% endif %}
                    </div>
                {% endif %}

                <a href="{{ path('announcement_show', {id: announcement.id}) }}" class="btn btn-outline btn-block">Voir l'annonce</a>
            </aside>
        </div>
    </div>
{% endblock %}
