{# =========================================================
   Macros d'interface partagées
   Usage : {% import '_partials/ui.html.twig' as ui %}
   ========================================================= #}

{% macro tone(seed) -%}
    {{- ['green', 'terracotta', 'ochre', 'plum', 'slate', 'sage'][(seed ?? 0) % 6] -}}
{%- endmacro %}

{# Couverture de livre générée en CSS #}
{% macro cover(title, author = null, seed = 0) %}
    <div class="cover cover--{{ _self.tone(seed) }}" aria-hidden="true">
        <span class="cover__title">{{ title }}</span>
        {% if author %}<span class="cover__author">{{ author }}</span>{% endif %}
        <span class="cover__ornament"></span>
    </div>
{% endmacro %}

{# Photo d'un livre, au même format qu'une couverture.
   La couverture générée est dessinée dessous : si l'image ne charge pas (fichier supprimé,
   site d'hébergement en panne…), le contrôleur Stimulus « photo » masque l'image et la couverture reste visible. #}
{% macro photo(url, alt = '', seed = 0, title = null, author = null) %}
    <div class="cover-photo">
        {{ _self.cover(title ?? '', author, seed) }}
        <img class="cover-photo__img" src="{{ url }}" alt="{{ alt }}" loading="lazy" data-controller="photo" data-action="error->photo#fail">
    </div>
{% endmacro %}

{# Couverture d'une annonce : la vraie photo si elle existe, sinon une couverture générée.
   Plusieurs livres : une pile. #}
{% macro cover_for(announcement, books) %}
    {% set first = books|first %}
    {% set withPhoto = books|filter(b => b.coverUrl)|first %}
    {% set photo = withPhoto ? withPhoto.coverUrl : null %}
    {% if books|length > 1 %}
        <div class="cover-stack">
            {% if photo %}
                {{ _self.photo(photo, announcement.title, announcement.id, announcement.title, books|length ~ ' livres') }}
            {% else %}
                {{ _self.cover(announcement.title, books|length ~ ' livres', announcement.id) }}
            {% endif %}
            {{ _self.cover('', null, announcement.id + 1) }}
            {{ _self.cover('', null, announcement.id + 2) }}
        </div>
    {% elseif photo %}
        {{ _self.photo(photo, first.title, announcement.id, first.title, first.author) }}
    {% else %}
        {{ _self.cover(first ? first.title : announcement.title, first ? first.author : null, announcement.id) }}
    {% endif %}
{% endmacro %}

{# Avatar avec initiales #}
{# Avatar : la photo de profil si elle existe (initiales dessous, visibles si l'image ne charge pas), sinon les initiales #}
{% macro avatar(user, size = null) %}
    {% set name = user ? user.username : '?' %}
    <span class="avatar avatar--{{ _self.tone(user ? user.id : 0) }} {{ size ? 'avatar--' ~ size }}" aria-hidden="true">
        {{- name|slice(0, 2) -}}
        {%- if user and user.avatarUrl -%}
            <img class="avatar__img" src="{{ user.avatarUrl }}" alt="" loading="lazy" data-controller="photo" data-action="error->photo#fail">
        {%- endif -%}
    </span>
{% endmacro %}

{# Pseudo cliquable vers le profil public #}
{% macro user_link(user) -%}
    <a href="{{ path('user_show', {username: user.username}) }}" class="user-link">{{ user.username }}</a>
{%- endmacro %}

{# ---------- Badges des enums ----------
   Les libellés et couleurs sont définis dans les enums (src/Enum) :
   label(), color() et level(). Ici on ne fait que l'affichage. #}

{% macro type_badge(type) %}
    <span class="badge badge--{{ type.color }}">{{ type.value == 'donation' ? '♥ ' }}{{ type.label }}</span>
{% endmacro %}

{% macro condition(condition) %}
    <span class="condition" title="{{ condition.label }}">
        <span class="condition__bar" aria-hidden="true">
            {% for i in 1..5 %}<i class="{{ i <= condition.level ? 'on' }}"></i>{% endfor %}
        </span>
        {{ condition.label }}
    </span>
{% endmacro %}

{% macro announcement_status(status) %}
    <span class="badge badge--dot badge--{{ status.color }}">{{ status.label }}</span>
{% endmacro %}

{% macro exchange_status(status) %}
    <span class="badge badge--dot badge--{{ status.color }}">{{ status.label }}</span>
{% endmacro %}

{% macro price(announcement) %}
    {% if announcement.price is null %}
        <span class="price-tag price-tag--free">Gratuit</span>
    {% else %}
        <span class="price-tag">{{ announcement.price|number_format(2, ',', ' ') }}&nbsp;€</span>
    {% endif %}
{% endmacro %}

{# Étagère décorative #}
{% macro shelf(rows = 2) %}
    {% set spines = [
        ['green', 34, 82, ''], ['terracotta', 44, 96, 'Les Misérables'], ['ochre', 28, 74, ''],
        ['plum', 40, 90, 'Candide'], ['slate', 32, 78, ''], ['sage', 46, 100, 'Germinal'],
        ['terracotta', 30, 70, ''], ['green', 38, 88, 'Nana']
    ] %}
    <div class="shelf" aria-hidden="true">
        <div class="shelf__row">
            {% for s in spines %}
                <div class="spine {{ s[3] ? 'spine--label' }} {{ loop.index == 7 ? 'spine--lean' }}"
                     style="--c: var(--{{ s[0] }}); --w: {{ s[1] }}px; --h: {{ s[2] }}%; --i: {{ loop.index }}">
                    {% if s[3] %}<span>{{ s[3] }}</span>{% endif %}
                </div>
            {% endfor %}
        </div>
        {% if rows > 1 %}
            <div class="shelf__row">
                {% for s in spines|slice(2, 5)|reverse %}
                    <div class="spine {{ s[3] ? 'spine--label' }}"
                         style="--c: var(--{{ s[0] }}); --w: {{ s[1] }}px; --h: {{ s[2] - 6 }}%; --i: {{ loop.index + 8 }}">
                        {% if s[3] %}<span>{{ s[3] }}</span>{% endif %}
                    </div>
                {% endfor %}
                <div class="shelf__plant"></div>
            </div>
        {% endif %}
    </div>
{% endmacro %}

{# Attributs à poser sur un <form> pour demander une confirmation avant l'envoi (contrôleur Stimulus « confirm »).
   Usage : <form method="post" … {{ ui.confirm('Retirer cette annonce ?', 'Retirer') }}> #}
{% macro confirm(message, button = 'Confirmer') -%}
    data-controller="confirm" data-action="confirm#ask" data-confirm-message-value="{{ message|e('html_attr') }}" data-confirm-button-value="{{ button|e('html_attr') }}"
{%- endmacro %}
