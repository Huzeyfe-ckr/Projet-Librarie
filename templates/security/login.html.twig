{% extends 'base.html.twig' %}
{% import '_partials/ui.html.twig' as ui %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="auth">
        <figure class="auth__art">
            <div>
                <blockquote>« Un livre est un jardin que l'on porte dans sa poche. »</blockquote>
                <figcaption>Proverbe arabe</figcaption>
            </div>
            {{ ui.shelf(1) }}
        </figure>

        <div class="auth__form">
            <div>
                <p class="eyebrow">Content de te revoir</p>
                <h1>Connexion</h1>
                <p class="muted">Retrouve tes annonces et tes conversations.</p>

                {% if error %}
                    <div class="flash flash--error mt-5">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" class="form">
                    <label for="email">Adresse email</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" placeholder="toi@exemple.fr" required autofocus>

                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required>
                    <p class="small mt-3 m-0"><a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a></p>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary btn-block btn-lg mt-6">Se connecter</button>
                </form>

                <p class="auth__alt">Pas encore de compte ? <a href="{{ path('app_register') }}">Inscris-toi</a></p>
            </div>
        </div>
    </div>
{% endblock %}
