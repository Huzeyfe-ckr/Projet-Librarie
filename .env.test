# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Les tests tournent sur une base SQLite jetable (var/test.db) :
# pas besoin de droits MySQL supplémentaires et la base de dev n'est jamais touchée.
TEST_DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# En test, aucun email n'est réellement envoyé (les tests les inspectent avec assertEmailCount, getMailerMessage…)
MAILER_DSN=null://null
